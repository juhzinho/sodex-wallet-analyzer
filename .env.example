# SoDEX Wallet Analyzer — environment variables

# Optional: override the default SoDEX gateway base URLs
# SODEX_PERPS_BASE=https://mainnet-gw.sodex.dev/api/v1/perps
# SODEX_SPOT_BASE=https://mainnet-gw.sodex.dev/api/v1/spot

# Default = COMPLETE wallet analysis (all trades & positions).
# Set to "true" only for a faster scan (last 31 days of trades).
# SODEX_FAST_MODE=false

# Fast-mode only: days of trade history (default 31)
# SODEX_TRADES_LOOKBACK_DAYS=31

# Full-history parallel fetch tuning
# SODEX_FETCH_CONCURRENCY=6
# SODEX_TIME_CHUNK_DAYS=30

# Set to "true" to include funding history (slower)
# SODEX_FETCH_FUNDING=false

# Server cache TTL in ms (default 900000 = 15 min)
# ANALYSIS_CACHE_TTL_MS=900000

# Max analysis requests per IP per minute (default 10)
# RATE_LIMIT_PER_MINUTE=10
